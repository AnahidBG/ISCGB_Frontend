{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      // Levanta la API de .NET en http://localhost:5231.
      //
      // La ruta es relativa y asume que los dos repositorios están clonados
      // uno al lado del otro:
      //
      //   ISCGB/
      //     ├── ISCGB_Frontend/   ← esta carpeta
      //     └── ISCGB_Backend/
      //
      // Si alguien los tiene en otro lado, ajusta esta línea.
      "label": "API (.NET)",
      "type": "shell",
      "command": "dotnet",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/../ISCGB_Backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "iscgb",
        "panel": "dedicated"
      }
    },
    {
      // Arranca el frontend y la API a la vez, cada uno en su terminal.
      "label": "Levantar todo",
      "dependsOn": ["npm: start", "API (.NET)"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
